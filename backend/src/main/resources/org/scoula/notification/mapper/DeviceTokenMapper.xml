<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.notification.mapper.DeviceTokenMapper">

    <!-- 기기토큰 저장 : 같은 fcm_token이면 user_id 갱신 -->
    <insert id="insertOrUpdate">
        INSERT INTO device_token (user_id, fcm_token)
        VALUES (#{userId}, #{fcmToken})
            ON DUPLICATE KEY UPDATE
                                 user_id = VALUES(user_id),
                                 created_at = NOW()
    </insert>

    <!-- 유저의 모든 기기토큰 조회 (멀티 디바이스) -->
    <select id="selectTokensByUserId" resultType="string">
        SELECT fcm_token FROM device_token WHERE user_id = #{userId}
    </select>

    <!-- 로그아웃 시 해당 유저의 모든 기기토큰 삭제
         token_version 증가로 다른 기기도 함께 로그아웃되므로 토큰도 user_id 기준으로 일괄 제거 -->
    <delete id="deleteAllByUserId">
        DELETE FROM device_token WHERE user_id = #{userId}
    </delete>

</mapper>