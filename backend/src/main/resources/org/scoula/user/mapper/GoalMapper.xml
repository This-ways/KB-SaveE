<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.scoula.user.mapper.GoalMapper">

    <resultMap id="goalMap" type="org.scoula.user.domain.GoalVO">
        <id property="goalId" column="goal_id" />
        <result property="userId" column="user_id" />
        <result property="categoryId" column="category_id" />
        <result property="yearMonth" column="year_month" />
        <result property="targetAmount" column="target_amount" />
    </resultMap>

    <insert id="insert" parameterType="org.scoula.user.domain.GoalVO" useGeneratedKeys="true" keyProperty="goalId">
        INSERT INTO `goal` (user_id, category_id, `year_month`, target_amount)
        VALUES (#{userId}, #{categoryId}, #{yearMonth}, #{targetAmount})
    </insert>

    <update id="update" parameterType="org.scoula.user.domain.GoalVO">
        UPDATE `goal`
        SET target_amount = #{targetAmount}
        WHERE goal_id = #{goalId}
    </update>

    <select id="findByUserAndYearMonth" resultMap="goalMap">
        SELECT goal_id, user_id, category_id, `year_month`, target_amount
        FROM `goal`
        WHERE user_id = #{userId}
          AND `year_month` = #{yearMonth}
    </select>

    <select id="findOne" resultMap="goalMap">
        SELECT goal_id, user_id, category_id, `year_month`, target_amount
        FROM `goal`
        WHERE user_id = #{userId}
          AND category_id = #{categoryId}
          AND `year_month` = #{yearMonth}
    </select>

</mapper>
