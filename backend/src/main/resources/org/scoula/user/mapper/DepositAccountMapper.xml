<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.scoula.user.mapper.DepositAccountMapper">

    <resultMap id="depositMap" type="org.scoula.user.domain.DepositAccountVO">
        <id property="depositId" column="deposit_id" />
        <result property="userId" column="user_id" />
        <result property="balance" column="balance" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <insert id="insert" parameterType="org.scoula.user.domain.DepositAccountVO" useGeneratedKeys="true" keyProperty="depositId">
        INSERT INTO `deposit_account` (user_id, balance)
        VALUES (#{userId}, #{balance})
    </insert>

    <select id="findByUserId" resultMap="depositMap">
        SELECT deposit_id, user_id, balance, created_at, updated_at
        FROM `deposit_account`
        WHERE user_id = #{userId}
    </select>

</mapper>
