<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.scoula.user.mapper.UserMapper">

    <insert id="insert" parameterType="org.scoula.user.domain.UserVO" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO `user` (login_id, password, user_name, birth_date, push_enabled)
        VALUES (#{loginId}, #{password}, #{userName}, #{birthDate}, #{pushEnabled})
    </insert>

    <select id="existsByLoginId" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM `user` WHERE login_id = #{loginId}
    </select>

    <update id="updateMydataConnected">
        UPDATE `user`
        SET mydata_connected = #{connected}
        WHERE user_id = #{userId}
    </update>

    <select id="findMydataConnected" resultType="boolean">
        SELECT mydata_connected FROM `user` WHERE user_id = #{userId}
    </select>

    <update id="incrementTokenVersion">
        UPDATE `user`
        SET token_version = token_version + 1
        WHERE user_id = #{userId}
    </update>

    <select id="findPushEnabled" resultType="boolean">
        SELECT push_enabled FROM `user` WHERE user_id = #{userId}
    </select>

    <update id="updatePushEnabled">
        UPDATE `user`
        SET push_enabled = #{enabled}
        WHERE user_id = #{userId}
    </update>

</mapper>
